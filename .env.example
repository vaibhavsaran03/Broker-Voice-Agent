# Sarvam AI (STT + TTS for Indian languages, Hinglish code-switching)
# Free tier: 1,000 credits - https://www.sarvam.ai/
SARVAM_API_KEY=
# models are overridable; these defaults are known-good
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=neha

# Groq (dialogue LLM) - free tier at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# WebRTC NAT traversal (defaults work out of the box; override for your own relay)
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:your-turn-host:3478?transport=udp,turns:your-turn-host:443?transport=tcp
TURN_USERNAME=your-provider-issued-username
TURN_CREDENTIAL=your-provider-issued-credential
